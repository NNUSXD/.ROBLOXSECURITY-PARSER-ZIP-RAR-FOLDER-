<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>dread_icon.ico</ApplicationIcon>
    <AssemblyName>DreadParser</AssemblyName>
    <RootNamespace>DreadParser</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>DREAD PARSER</Authors>
    <Company>DREAD PARSER</Company>
    <Product>DREAD PARSER - Roblox Cookie Parser</Product>
    <Description>⚡ DREAD PARSER - Максимальная Полнота Поиска .ROBLOSECURITY токенов</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetZip" Version="1.16.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SevenZipSharp" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="dread_icon.ico" Condition="Exists('dread_icon.ico')" />
  </ItemGroup>

</Project>
